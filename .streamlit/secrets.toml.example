# ThingSpeak Cloud Configuration Template
# Copy this file to .streamlit/secrets.toml and enter your actual ThingSpeak keys.
# DO NOT commit .streamlit/secrets.toml to version control (it is ignored by .gitignore).

[thingspeak]
channel_id = "YOUR_CHANNEL_ID_HERE"           # e.g., "2891234"
write_api_key = "YOUR_WRITE_API_KEY_HERE"     # 16-character ThingSpeak Write API Key
read_api_key = "YOUR_READ_API_KEY_HERE"       # Optional: required only for private channels
upload_interval = 15                          # Minimum 15 seconds for Free ThingSpeak accounts

